{
  "name": "khoguard-iot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test",
    "infra:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "infra:mqtt:start": "node scripts/start-mqtt.mjs",
    "infra:db:init": "node scripts/provision-mysql.mjs",
    "infra:mqtt:check": "node scripts/check-mqtt.mjs",
    "infra:db:check": "node scripts/check-mysql.mjs",
    "infra:secrets:check": "node scripts/check-secret-files.mjs",
    "firmware:prepare": "node scripts/prepare-firmware.mjs",
    "firmware:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-firmware.ps1",
    "firmware:check": "node scripts/check-firmware.mjs",
    "firmware:gateway:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-wokwi.ps1",
    "firmware:gateway:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-wokwi.ps1",
    "db:migrate": "node --env-file=.local/runtime.env scripts/migrate-db.mjs",
    "backend:start": "node --env-file=.local/runtime.env server/start.mjs",
    "backend:check": "node --env-file=.local/runtime.env scripts/check-backend.mjs"
  },
  "dependencies": {
    "mqtt": "^5.16.0",
    "mysql2": "^3.24.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "vite": "^8.3.4"
  }
}
