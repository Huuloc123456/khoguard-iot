{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:khoguard:mqtt:v1",
  "title": "KhoGuard MQTT envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "warehouse_id", "device_id", "boot_id", "session_id", "seq", "kind", "clock_synced", "sent_at", "uptime_ms", "payload"],
  "properties": {
    "schema_version": { "const": 1 },
    "warehouse_id": { "const": "WH01" },
    "device_id": { "type": "string", "pattern": "^[A-Z0-9-]{1,32}$" },
    "boot_id": { "$ref": "#/definitions/token" },
    "session_id": { "$ref": "#/definitions/token" },
    "seq": { "$ref": "#/definitions/counter" },
    "kind": { "enum": ["telemetry", "events", "status", "commands", "acks"] },
    "clock_synced": { "type": "boolean" },
    "sent_at": { "anyOf": [{ "$ref": "#/definitions/utc" }, { "type": "null" }] },
    "uptime_ms": { "$ref": "#/definitions/counter" },
    "event_id": { "$ref": "#/definitions/token" },
    "payload": { "type": "object" }
  },
  "allOf": [
    { "if": { "properties": { "clock_synced": { "const": true } } }, "then": { "properties": { "sent_at": { "$ref": "#/definitions/utc" } } }, "else": { "properties": { "sent_at": { "type": "null" } } } },
    { "if": { "properties": { "kind": { "const": "telemetry" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/telemetry" } } } },
    { "if": { "properties": { "kind": { "const": "events" } } }, "then": { "required": ["event_id"], "properties": { "event_id": { "$ref": "#/definitions/token" }, "payload": { "$ref": "#/definitions/event" } } }, "else": { "not": { "required": ["event_id"], "properties": { "event_id": { "$ref": "#/definitions/token" } } } } },
    { "if": { "properties": { "kind": { "const": "status" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/status" } } } },
    { "if": { "properties": { "kind": { "const": "commands" } } }, "then": { "properties": { "clock_synced": { "const": true }, "payload": { "$ref": "#/definitions/command" } } } },
    { "if": { "properties": { "kind": { "const": "acks" } } }, "then": { "properties": { "payload": { "$ref": "#/definitions/ack" } } } }
  ],
  "definitions": {
    "counter": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "token": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9:_-]+$" },
    "utc": { "type": "string", "format": "date-time", "maxLength": 24, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9](\\.[0-9]{1,3})?Z$" },
    "zone": { "enum": ["A", "B", "C", "D"] },
    "doorId": { "type": "string", "pattern": "^D(0[1-9]|1[0-2])$" },
    "signal": { "type": ["boolean", "null"] },
    "doorState": { "enum": ["open", "closed", "opening", "closing", "unknown"] },
    "reason": { "enum": ["OCCUPIED", "PRESENCE_DETECTED", "BEAM_BLOCKED", "PANIC_ACTIVE", "INPUT_UNKNOWN", "INTERLOCK_ACTIVE", "STALE_DATA", "REVISION_MISMATCH", "COMMAND_EXPIRED", "NOT_AUTHORIZED", "LOCAL_INPUT_FAILURE"] },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature_c", "humidity_pct"],
      "properties": {
        "temperature_c": { "type": ["number", "null"], "minimum": -100, "maximum": 100 },
        "humidity_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "co2_ppm": { "type": ["number", "null"], "minimum": 0, "maximum": 100000 }
      }
    },
    "occupancy": {
      "type": "object", "additionalProperties": false,
      "required": ["current_occupants", "count_verified", "presence"],
      "properties": {
        "current_occupants": { "type": ["integer", "null"], "minimum": 0, "maximum": 10000 },
        "count_verified": { "type": "boolean" },
        "presence": { "$ref": "#/definitions/signal" }
      },
      "if": { "properties": { "count_verified": { "const": true } } },
      "then": { "properties": { "current_occupants": { "type": "integer" } } }
    },
    "door": {
      "type": "object", "additionalProperties": false,
      "required": ["door_id", "state", "beam_clear", "panic_latched", "local_inputs_healthy"],
      "properties": {
        "door_id": { "$ref": "#/definitions/doorId" },
        "state": { "$ref": "#/definitions/doorState" },
        "beam_clear": { "$ref": "#/definitions/signal" },
        "panic_latched": { "$ref": "#/definitions/signal" },
        "local_inputs_healthy": { "type": "boolean" },
        "locked": { "type": "boolean" },
        "open_ms": { "$ref": "#/definitions/counter" }
      }
    },
    "alarm": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {
        "code": { "enum": ["DOOR_OPEN_WARNING", "DOOR_OPEN_CRITICAL", "TRAPPED_PERSON"] },
        "door_id": { "$ref": "#/definitions/doorId" }
      },
      "if": { "properties": { "code": { "const": "TRAPPED_PERSON" } } },
      "then": { "not": { "required": ["door_id"], "properties": { "door_id": { "$ref": "#/definitions/doorId" } } } },
      "else": { "required": ["door_id"], "properties": { "door_id": { "$ref": "#/definitions/doorId" } } }
    },
    "outputs": {
      "type": "object", "additionalProperties": false, "required": ["light", "buzzer", "heater", "fan"],
      "properties": { "light": { "type": "boolean" }, "buzzer": { "type": "boolean" }, "heater": { "type": "boolean" }, "fan": { "type": "boolean" } }
    },
    "telemetry": {
      "type": "object", "additionalProperties": false, "required": ["zone_id", "controller_revision"],
      "properties": {
        "zone_id": { "$ref": "#/definitions/zone" },
        "controller_revision": { "$ref": "#/definitions/counter" },
        "environment": { "$ref": "#/definitions/environment" },
        "occupancy": { "$ref": "#/definitions/occupancy" },
        "doors": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/definitions/door" } },
        "alarms": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/alarm" } },
        "outputs": { "$ref": "#/definitions/outputs" }
      },
      "anyOf": [
        { "required": ["environment"], "properties": { "environment": { "$ref": "#/definitions/environment" } } },
        { "required": ["occupancy"], "properties": { "occupancy": { "$ref": "#/definitions/occupancy" } } },
        { "required": ["doors"], "properties": { "doors": { "type": "array" } } }
      ]
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["zone_id", "event_type", "door_id"],
      "properties": {
        "zone_id": { "$ref": "#/definitions/zone" },
        "event_type": { "enum": ["rfid", "panic", "door", "command_rejected"] },
        "door_id": { "$ref": "#/definitions/doorId" },
        "card_id": { "$ref": "#/definitions/token" },
        "direction": { "enum": ["in", "out"] },
        "input": { "enum": ["panic_low", "panic_high"] },
        "state": { "$ref": "#/definitions/doorState" },
        "command_id": { "$ref": "#/definitions/token" },
        "reason": { "$ref": "#/definitions/reason" },
        "result": { "enum": ["accepted", "duplicate", "unauthorized"] }
      },
      "allOf": [
        { "if": { "properties": { "event_type": { "const": "rfid" } } }, "then": { "required": ["card_id", "direction", "result"], "properties": { "card_id": { "$ref": "#/definitions/token" }, "direction": { "enum": ["in", "out"] }, "result": { "enum": ["accepted", "duplicate", "unauthorized"] } } }, "else": { "not": { "required": ["result"], "properties": { "result": { "enum": ["accepted", "duplicate", "unauthorized"] } } } } },
        { "if": { "properties": { "event_type": { "const": "panic" } } }, "then": { "required": ["input"], "properties": { "input": { "enum": ["panic_low", "panic_high"] } } } },
        { "if": { "properties": { "event_type": { "const": "door" } } }, "then": { "required": ["state"], "properties": { "state": { "$ref": "#/definitions/doorState" } } } },
        { "if": { "properties": { "event_type": { "const": "command_rejected" } } }, "then": { "required": ["command_id", "reason"], "properties": { "command_id": { "$ref": "#/definitions/token" }, "reason": { "$ref": "#/definitions/reason" } } } }
      ]
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["zone_id", "state"],
      "properties": { "zone_id": { "$ref": "#/definitions/zone" }, "state": { "enum": ["online", "offline"] } }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["zone_id", "door_id", "command_id", "action", "expires_at", "expected_revision"],
      "properties": {
        "zone_id": { "$ref": "#/definitions/zone" },
        "door_id": { "$ref": "#/definitions/doorId" },
        "command_id": { "$ref": "#/definitions/token" },
        "action": { "enum": ["open", "close", "reset_panic"] },
        "expires_at": { "$ref": "#/definitions/utc" },
        "expected_revision": { "$ref": "#/definitions/counter" }
      }
    },
    "ack": {
      "type": "object", "additionalProperties": false,
      "required": ["zone_id", "door_id", "command_id", "status", "reason"],
      "properties": {
        "zone_id": { "$ref": "#/definitions/zone" },
        "door_id": { "$ref": "#/definitions/doorId" },
        "command_id": { "$ref": "#/definitions/token" },
        "status": { "enum": ["applied", "rejected", "expired"] },
        "reason": { "anyOf": [{ "$ref": "#/definitions/reason" }, { "type": "null" }] }
      },
      "if": { "properties": { "status": { "const": "applied" } } },
      "then": { "properties": { "reason": { "type": "null" } } },
      "else": { "properties": { "reason": { "$ref": "#/definitions/reason" } } }
    }
  }
}
