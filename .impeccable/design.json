  "narrative": {
    "northStar": "A basic warehouse operating plan",
    "overview": "The implemented world follows the user's basic white-background direction: white surfaces, fine cool-gray borders, charcoal text and restrained teal selection. It favors compact operational information over decorative imagery.\n\nThe four-zone plan is drawn with CSS geometry and small outline SVG icons. Environmental readings, door states and alerts remain textual as well as colored; the interface explicitly identifies demonstration data.",
    "keyCharacteristics": [
      "White surfaces with fine dividing rules.",
      "Teal selection with amber and red semantic states.",
      "Compact controls and a selectable schematic.",
      "Flat depth with no decorative shadows."
    ],
    "rules": [
      {
        "name": "The State Has Words Rule",
        "body": "Pair state color with explicit text so warnings, selection and door state remain readable without interpreting hue alone.",
        "section": "colors"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use border and tonal changes for emphasis, as the shipped panels and controls do.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the user's white-background direction and fine panel divisions.",
      "Do pair operational state colors with explicit text.",
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do identify simulated data and disconnected integrations explicitly."
    ],
    "donts": [
      "Don't replace the basic operating interface with decorative imagery or ornamental depth.",
      "Don't imply that accepting an alert changes sensor conditions or door interlocks.",
      "Don't copy the existing tiny schematic labels or system-font page display treatment into new surfaces as a house standard."
    ]
  }
