{
  "info": {
    "name": "KhoGuard — API demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Import collection; điền password ở Current value trên máy. Chạy folder 01 và 02 để kiểm tra chỉ đọc. Folder 03 vận hành phải chạy từng request bằng operator; có thay đổi trạng thái demo."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:3001",
      "type": "string"
    },
    {
      "key": "username",
      "value": "viewer",
      "type": "string"
    },
    {
      "key": "password",
      "value": "",
      "type": "string"
    },
    {
      "key": "door_id",
      "value": "D07",
      "type": "string"
    },
    {
      "key": "command_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "alert_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "request_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservation_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 — Kết nối và đăng nhập",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://127.0.0.1:5173"
              }
            ],
            "url": "{{base_url}}/api/health",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ready",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "http://127.0.0.1:5173"
