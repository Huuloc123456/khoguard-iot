                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/doors/{{door_id}}/commands",
            "description": "Lấy command_id từ response; cửa chỉ đổi khi telemetry xác nhận.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"open\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
