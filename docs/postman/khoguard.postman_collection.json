    {
      "name": "03 — Vận hành (operator, chạy từng request)",
      "item": [
        {
          "name": "Mở cửa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "http://127.0.0.1:5173"
